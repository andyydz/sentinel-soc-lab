<group name="sentinel,sysmon,windows,">
  <rule id="100100" level="0"><decoded_as>json</decoded_as><field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field><description>Sysmon</description></rule>
  <rule id="100101" level="0"><if_sid>100100</if_sid><field name="win.system.eventID">^1$</field><description>EID1</description></rule>
  <rule id="100102" level="0"><if_sid>100100</if_sid><field name="win.system.eventID">^3$</field><description>EID3</description></rule>
  <rule id="100103" level="0"><if_sid>100100</if_sid><field name="win.system.eventID">^10$</field><description>EID10</description></rule>
  <rule id="100104" level="0"><if_sid>100100</if_sid><field name="win.system.eventID">^11$</field><description>EID11</description></rule>
  <rule id="100110" level="12"><if_sid>100101</if_sid><field name="win.eventdata.parentImage" type="pcre2">(?i)\\svchost\.exe$</field><field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh)\.exe$</field><description>SENTINEL Sysmon: Suspicious shell spawned by svchost.exe</description><mitre><id>T1059.003</id></mitre><group>sentinel_sysmon_replay,</group></rule>
  <rule id="100111" level="10"><if_sid>100101</if_sid><field name="win.eventdata.image" type="pcre2">(?i)\\(cscript|wscript)\.exe$</field><field name="win.eventdata.commandLine" type="pcre2">(?i)(programdata|\\temp\\|\\users\\public\\|memdump)</field><description>SENTINEL Sysmon: Suspicious Windows script execution</description><mitre><id>T1059.005</id></mitre><group>sentinel_sysmon_replay,</group></rule>
  <rule id="100112" level="13"><if_sid>100101</if_sid><field name="win.eventdata.image" type="pcre2">(?i)\\rundll32\.exe$</field><field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs\.dll.*minidump</field><description>SENTINEL Sysmon: Memory dump via rundll32 comsvcs.dll MiniDump</description><mitre><id>T1003.001</id><id>T1218.011</id></mitre><group>sentinel_sysmon_replay,</group></rule>
  <rule id="100120" level="8"><if_sid>100102</if_sid><field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field><description>SENTINEL Sysmon: PowerShell outbound connection to $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description><mitre><id>T1059.001</id><id>T1105</id></mitre><group>sentinel_sysmon_replay,</group></rule>
  <rule id="100130" level="14"><if_sid>100103</if_sid><field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field><field name="win.eventdata.sourceImage" type="pcre2">(?i)\\(powershell|pwsh|rundll32|cmd|cscript|wscript|mshta)\.exe$</field><description>SENTINEL Sysmon: LSASS access by $(win.eventdata.sourceImage)</description><mitre><id>T1003.001</id></mitre><group>sentinel_sysmon_replay,</group></rule>
  <rule id="100131" level="12"><if_sid>100103</if_sid><field name="win.eventdata.sourceImage" type="pcre2">(?i)\\rundll32\.exe$</field><field name="win.eventdata.callTrace" type="pcre2">(?i)(comsvcs|dbgcore)\.dll</field><description>SENTINEL Sysmon: Memory dump process access via rundll32 comsvcs/dbgcore</description><mitre><id>T1003.001</id><id>T1218.011</id></mitre><group>sentinel_sysmon_replay,</group></rule>
  <rule id="100140" level="10"><if_sid>100104</if_sid><field name="win.eventdata.image" type="pcre2">(?i)\\rundll32\.exe$</field><field name="win.eventdata.targetFilename" type="pcre2">(?i)\\windows\\system32\\.*\.(bin|dmp)$</field><description>SENTINEL Sysmon: Dump file created by rundll32.exe</description><mitre><id>T1003.001</id></mitre><group>sentinel_sysmon_replay,</group></rule>
</group>
