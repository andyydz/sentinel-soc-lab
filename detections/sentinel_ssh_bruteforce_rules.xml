<!-- SENTINEL v0.5 — SSH Brute Force (MITRE T1110) -->

<group name="local,syslog,sshd,sentinel_ssh_bruteforce,">

  <!-- Base match on built-in SSHD invalid-user / auth failure (Wazuh rules 5710, 5716) -->
  <rule id="100200" level="5">
    <if_sid>5710, 5716</if_sid>
    <description>SENTINEL SSH: Authentication failure observed on monitored host.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,sentinel_ssh_bruteforce,</group>
  </rule>

  <!-- Frequency escalation for repeated SSH authentication failures from one source -->
  <rule id="100201" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_srcip />
    <description>SENTINEL SSH: Potential brute-force activity (6+ failed attempts within 60s from $(srcip)).</description>
    <mitre>
      <id>T1110</id>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,sentinel_ssh_bruteforce,brute_force,</group>
  </rule>

</group>
