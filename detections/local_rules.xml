<group name="local,syslog,sshd,">

  <!-- Existing Rule 100001: SSH authentication failure -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- Rule 100002: File modification -->
  <rule id="100002" level="8">
    <if_sid>550</if_sid>
    <field name="file">^/home/</field>
    <description>SENTINEL: File integrity modification detected in monitored home directory.</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>sentinel_fim,</group>
  </rule>

  <!-- Rule 100003: File creation -->
  <rule id="100003" level="8">
    <if_sid>554</if_sid>
    <field name="file">^/home/</field>
    <description>SENTINEL: New file created in monitored home directory.</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>sentinel_fim,</group>
  </rule>

  <!-- Rule 100004: File deletion -->
  <rule id="100004" level="8">
    <if_sid>553</if_sid>
    <field name="file">^/home/</field>
    <description>SENTINEL: File deleted from monitored home directory.</description>
    <mitre>
      <id>T1070.004</id>
    </mitre>
    <group>sentinel_fim,</group>
  </rule>

</group>
